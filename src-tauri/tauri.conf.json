{
    "$schema": "https://schema.tauri.app/config/2",
    "productName": "nexus-translate",
    "version": "2.5.0",
    "identifier": "com.nexusheader.translate",
    "build": {
        "beforeDevCommand": "npm run dev",
        "beforeBuildCommand": "npm run build:tauri",
        "devUrl": "http://localhost:1430",
        "frontendDist": "../dist"
    },
    "app": {
        "macOSPrivateApi": true,
        "windows": [
            {
                "label": "main",
                "title": "",
                "width": 800,
                "height": 600,
                "resizable": true,
                "decorations": true,
                "transparent": false,
                "fullscreen": false,
                "shadow": true
            },
            {
                "label": "screenshot",
                "url": "index.html?mode=screenshot",
                "decorations": false,
                "transparent": true,
                "alwaysOnTop": true,
                "visible": false,
                "skipTaskbar": true
            }
        ],
        "security": {
            "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost http://localhost:11434 http://127.0.0.1:11434 https://translate.googleapis.com https://api.openai.com https://api.anthropic.com https://generativelanguage.googleapis.com; img-src 'self' asset: https://asset.localhost; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline' 'unsafe-eval'"
        }
    },
    "bundle": {
        "active": true,
        "targets": [
            "nsis"
        ],
        "icon": [
            "icons/32x32.png",
            "icons/128x128.png",
            "icons/128x128@2x.png",
            "icons/icon.icns",
            "icons/icon.ico"
        ],
        "externalBin": [
            "translator",
            "NexusNative"
        ],
        "resources": [
            "*.dll",
            "models/nllb-200-distilled-600M/**/*"
        ],
        "windows": {
            "nsis": {
                "installMode": "both"
            }
        }
    },
    "plugins": {}
}
